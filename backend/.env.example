# 数据库连接 (替换为线上真实的 PostgreSQL 地址和密码)
DATABASE_URL="postgresql://<线上用户名>:<线上密码>@<线上数据库IP或域名>:5432/inkwell?schema=public"

# JWT Token Secret (生产环境请务必替换为一个长且随机的复杂字符串)
TOKEN_SECRET="your-production-secure-jwt-secret-key-here"

# 运行端口 (生产环境通常由进程管理器或容器指定，默认3000)
PORT=3000

# DeepSeek API
DEEPSEEK_API_KEY="你的_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# OpenAI API (302.ai proxy)
OPENAI_API_KEY="你的_OPENAI_API_KEY"
OPENAI_BASE_URL="https://api.302.ai/v1"

# 阿里云 DashScope API
DASHSCOPE_API_KEY="你的_DASHSCOPE_API_KEY"
